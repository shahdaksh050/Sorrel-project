# ============================================================
# Agentic Data Analysis System — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to git.
#
# NOTE: leave a variable's value truly empty when unset — do not put an
# inline "# comment" on the same line as an empty value. python-dotenv
# only strips inline comments after a non-empty value; on a blank value
# it treats the whole "# comment" text as the literal value, which
# silently breaks anything that checks `if os.getenv(...)`.
# ============================================================

# --- LLM Provider ---
# openai | anthropic | gemini | groq | openrouter | nvidia | local | ollama
LLM_PROVIDER=openai
# Model name. Leave blank to use the provider default (see _DEFAULT_MODELS
# in src/core/controller.py). Overridden by --model on the CLI.
LLM_MODEL=
LLM_TEMPERATURE=0.2          # Lower = more deterministic outputs
# Blank = per-stage defaults (planning 1500, sub-task 1200, chart/final 2500;
# 2048 base for local, 4096 for reasoning models). Set to force one value.
LLM_MAX_TOKENS=
# Request timeout in seconds. Blank = 600 for local/ollama, 120 for cloud.
LLM_TIMEOUT=
# Max simultaneous LLM calls (also caps RLM sub-task workers). Blank = 1 local, 4 cloud.
LLM_MAX_CONCURRENCY=
# Context window override (tokens); wins over the model table and LOCAL_LLM_CONTEXT.
# Leave commented out unless needed (a blank value is not accepted elsewhere).
# LLM_CONTEXT_TOKENS=32000
# none | low | medium | high | adaptive. Blank = provider default; the controller
# picks per stage (deeper for planning/synthesis, minimal for routine steps).
LLM_REASONING_EFFORT=
# Rate-limit ceilings (per minute). Blank = catalog/response-header values; 0 = unlimited.
LLM_RPM_LIMIT=
LLM_TPM_LIMIT=

# --- API Keys (only the active provider's key is required) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...
NVIDIA_API_KEY=nvapi-...

# --- Offline / self-hosted mode (LLM_PROVIDER=local or ollama) ---
# Works with any OpenAI-compatible server: Ollama, LM Studio, vLLM,
# llama.cpp server, text-generation-webui, etc. No cloud API key needed.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Only needed if your local server requires one; most don't.
LOCAL_LLM_API_KEY=
# Your server's REAL context in tokens (Ollama num_ctx, LM Studio context length).
# Blank = assume min(model window, 8192). Prompts that don't fit fall back cleanly.
LOCAL_LLM_CONTEXT=

# --- Agent Behaviour ---
MAX_ITERATIONS=15            # Max reasoning-execution cycles
ENABLE_RLM_INFERENCE=true    # Enable Stage 6 task decomposition
RLM_MAX_DEPTH=5              # Max recursion depth for sub-calls

# --- Output ---
OUTPUT_DIR=output            # Root output directory

# --- Optional: target column hint ---
# e.g. "churn", "price", "label" — leave blank for auto-detection.
TARGET_COLUMN_HINT=
